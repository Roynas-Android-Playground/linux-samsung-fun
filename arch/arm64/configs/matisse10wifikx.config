# Samsung Galaxy Tab Advanced 4 first-boot delta
#
# Generate on top of the established Exynos7870/postmarketOS configuration:
#   make ARCH=arm64 LLVM=1 defconfig exynos7870.config pmos.config \
#        matisse10wifikx.config

CONFIG_LOCALVERSION="-matisse10wifikx"
# CONFIG_LOCALVERSION_AUTO is not set

# Keep Samsung's required bootloader arguments, then append bring-up logging.
# The debug-shell hook is intentionally enabled for the first postmarketOS boot.
CONFIG_CMDLINE="earlycon console=ttySAC2,115200n8 loglevel=8 ignore_loglevel initcall_debug clk_ignore_unused pd_ignore_unused pmos.debug-shell"
CONFIG_CMDLINE_EXTEND=y

# Board PMIC and eMMC supplies must be available before the root filesystem.
CONFIG_MFD_SEC_I2C=y
CONFIG_REGULATOR_S2MPS11=y
CONFIG_RTC_DRV_S5M=y

# STMicroelectronics FTS controller at I2C1 address 0x49.
CONFIG_TOUCHSCREEN_STMFTS=y

# This is a single-SoC device kernel. Keep unrelated ARM64 platforms out of
# the resolved config without changing the shared defconfig or SoC fragments.
# CONFIG_ARCH_ACTIONS is not set
# CONFIG_ARCH_AIROHA is not set
# CONFIG_ARCH_SUNXI is not set
# CONFIG_ARCH_ALPINE is not set
# CONFIG_ARCH_APPLE is not set
# CONFIG_ARCH_ARTPEC is not set
# CONFIG_ARCH_AXIADO is not set
# CONFIG_ARCH_BCM2835 is not set
# CONFIG_ARCH_BCM_IPROC is not set
# CONFIG_ARCH_BCMBCA is not set
# CONFIG_ARCH_BRCMSTB is not set
# CONFIG_ARCH_BERLIN is not set
# CONFIG_ARCH_BLAIZE is not set
# CONFIG_ARCH_BST is not set
# CONFIG_ARCH_CIX is not set
# CONFIG_ARCH_K3 is not set
# CONFIG_ARCH_LG1K is not set
# CONFIG_ARCH_HISI is not set
# CONFIG_ARCH_KEEMBAY is not set
# CONFIG_ARCH_MEDIATEK is not set
# CONFIG_ARCH_MESON is not set
# CONFIG_ARCH_SPARX5 is not set
# CONFIG_ARCH_MVEBU is not set
# CONFIG_ARCH_LAYERSCAPE is not set
# CONFIG_ARCH_MXC is not set
# CONFIG_ARCH_S32 is not set
# CONFIG_ARCH_MA35 is not set
# CONFIG_ARCH_NPCM is not set
# CONFIG_ARCH_QCOM is not set
# CONFIG_ARCH_REALTEK is not set
# CONFIG_ARCH_RENESAS is not set
# CONFIG_ARCH_ROCKCHIP is not set
# CONFIG_ARCH_SEATTLE is not set
# CONFIG_ARCH_INTEL_SOCFPGA is not set
# CONFIG_ARCH_SOPHGO is not set
# CONFIG_ARCH_STM32 is not set
# CONFIG_ARCH_SYNQUACER is not set
# CONFIG_ARCH_TEGRA is not set
# CONFIG_ARCH_TESLA_FSD is not set
# CONFIG_ARCH_SPRD is not set
# CONFIG_ARCH_THUNDER is not set
# CONFIG_ARCH_THUNDER2 is not set
# CONFIG_ARCH_UNIPHIER is not set
# CONFIG_ARCH_VEXPRESS is not set
# CONFIG_ARCH_VISCONTI is not set
# CONFIG_ARCH_XGENE is not set
# CONFIG_ARCH_ZYNQMP is not set

# The tablet exposes no PCIe, ATA/SCSI/NVMe, Ethernet MAC, camera/media,
# CAN, NFC, MHI/WWAN, QRTR, DSA, or InfiniBand hardware. Keep the generic
# postmarketOS userspace features, SDIO Wi-Fi, Bluetooth, and USB gadget stack.
# CONFIG_PCI is not set
# CONFIG_ATA is not set
# CONFIG_BLK_DEV_NVME is not set
# CONFIG_ETHERNET is not set
# CONFIG_NET_DSA is not set
# CONFIG_CAN is not set
# CONFIG_NFC is not set
# CONFIG_MHI_BUS is not set
# CONFIG_WWAN is not set
# CONFIG_QRTR is not set
# CONFIG_INFINIBAND is not set
# CONFIG_CHROME_PLATFORMS is not set
# CONFIG_EFI is not set
# CONFIG_RPMSG_QCOM_GLINK_RPM is not set
# CONFIG_RPMSG_QCOM_SMD is not set

# Keep simpledrm for S-Boot's framebuffer and the Exynos/bridge/panel
# frameworks needed for the future native DECON/DSIM/LVDS path. Disable only
# unrelated GPU implementations.
CONFIG_DRM_SIMPLEDRM=y
# CONFIG_DRM_ETNAVIV is not set
# CONFIG_DRM_HDLCD is not set
# CONFIG_DRM_HISI_KIRIN is not set
# CONFIG_DRM_KOMEDA is not set
# CONFIG_DRM_LIMA is not set
# CONFIG_DRM_MALI_DISPLAY is not set
# CONFIG_DRM_PANFROST is not set
# CONFIG_DRM_PANTHOR is not set
# CONFIG_DRM_PL111 is not set
# CONFIG_DRM_POWERVR is not set
# CONFIG_DRM_TIDSS is not set
# CONFIG_DRM_UDL is not set
# CONFIG_DRM_V3D is not set

# Ramoops must be available before a root filesystem or modules are loaded.
CONFIG_PSTORE_RAM=y

# Keep the diagnostic kernel reasonably small without changing runtime support.
CONFIG_DEBUG_INFO_NONE=y
